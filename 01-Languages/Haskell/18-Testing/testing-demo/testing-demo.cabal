cabal-version:      2.4
name:                testing-demo
version:             0.1.0.0
build-type:          Simple

library
    exposed-modules: Calculator
    hs-source-dirs:  src
    build-depends:   base
    default-language: Haskell2010

test-suite spec
    type:             exitcode-stdio-1.0
    main-is:          Spec.hs
    hs-source-dirs:   test
    build-depends:    base, hspec, testing-demo
    default-language: Haskell2010
